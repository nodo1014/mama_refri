{
  "expo": {
    "name": "마마냉장고",
    "slug": "mama-refri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#a880ff"
    },
    "assetBundlePatterns": ["**/*"],
